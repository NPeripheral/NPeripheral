# =============================================================================
# NPeripheral — environment variables
#
# Copy this file to `.env.local` and fill in the values you need. `.env.local`
# is gitignored; this example file is the only env file that gets committed,
# and it must never contain a real key.
#
# Everything here is optional for local development — the site builds and runs
# with all of it unset. What each one switches on is noted below.
# =============================================================================

# --- Email delivery for the quote form ---------------------------------------
# REQUIRED BEFORE LAUNCH. Without these the contact form validates, redirects
# to /thank-you, and logs the enquiry server-side — but no email reaches you,
# so the lead is effectively lost.
#
# Get a key at https://resend.com → API Keys.
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=

# Sender address. Resend's shared `onboarding@resend.dev` sender can only
# deliver to the address that owns the Resend account. Verify your own domain
# in Resend to send anywhere else.
LEAD_FROM_EMAIL=NPeripheral <onboarding@resend.dev>

# --- Analytics ----------------------------------------------------------------
# GA4 measurement ID (looks like G-XXXXXXXXXX). No tracking script is loaded
# unless this is set, so an unconfigured deploy makes zero third-party requests.
NEXT_PUBLIC_GA_ID=

# --- Scheduling ---------------------------------------------------------------
# A Calendly (or similar) booking link. When set, the site offers "book a time"
# alongside the quote form. Protocol is optional.
NEXT_PUBLIC_CALENDLY_URL=

# --- Canonical URL ------------------------------------------------------------
# Used for canonical tags, Open Graph URLs, sitemap and robots.txt.
NEXT_PUBLIC_SITE_URL=https://www.nperipheral.com

# --- Optional CRM -------------------------------------------------------------
# Wire-up points exist in app/api/lead/route.ts but are commented out.
HUBSPOT_API_KEY=
GOHIGHLEVEL_API_KEY=
GOHIGHLEVEL_LOCATION_ID=

# --- Optional CMS -------------------------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
